# ==============================================================================
# RAG AI Assistant - Environment Configuration
# ==============================================================================

# LLM Provider Options: "offline", "gemini", "openai", "groq", "ollama"
LLM_PROVIDER=offline

# Model Name:
# For Gemini: gemini-1.5-flash, gemini-1.5-pro, gemini-2.0-flash
# For OpenAI: gpt-4o, gpt-4o-mini
# For Groq: llama-3.3-70b-versatile, llama-3.1-8b-instant
# For Ollama: llama3, mistral
MODEL_NAME=gemini-1.5-flash

# API Keys (optional if using 'offline' mode or 'ollama')
GEMINI_API_KEY=
OPENAI_API_KEY=
GROQ_API_KEY=

# Ollama Host (if using Ollama)
OLLAMA_BASE_URL=http://localhost:11434
